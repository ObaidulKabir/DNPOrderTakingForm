{
  "name": "printpilot-dnp-order-processing",
  "version": "1.0.0",
  "description": "PrintPilot Smart Print Sourcing — Refactored Backend & Dynamic Data Architecture",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --no-warnings --import tsx/esm --watch src/server.ts",
    "start": "node --experimental-sqlite --no-warnings --import tsx/esm src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.17",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "2.1.8",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
